# Railway Environment Variables (Variables tab)
# Neon PostgreSQL — use DATABASE_URL from Neon dashboard OR:

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

ConnectionStrings__DefaultConnection=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# JWT — generate long random string (min 32 chars)
JWT_KEY=your-super-secret-jwt-key-min-32-chars
Jwt__Key=your-super-secret-jwt-key-min-32-chars
Jwt__Issuer=Kaamil.Api
Jwt__Audience=Kaamil.Frontend

# CORS — your Vercel URL (comma separated, no spaces)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Railway sets PORT automatically — do not override
